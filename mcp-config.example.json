{
  "mcpServers": {
    "android": {
      "command": "node",
      "args": ["C:/path/to/mcp-android/bridge/server.js"],
      "env": {
        "ANDROID_MCP_TAILSCALE_URL": "http://100.x.y.z:8765",
        "ANDROID_MCP_TRANSPORT": "auto",
        "ANDROID_MCP_DISCOVERY": "true",
        "ANDROID_MCP_TOKEN": "REPLACE_WITH_THE_64_HEX_CHARACTERS_FROM_THE_PHONE"
      }
    }
  }
}
